# Registry credentials for NCCL benchmark scripts
# Copy this file to .env and fill in your values.
# .env is gitignored and will never be committed.
#
# Usage:
#   cp .env.example .env
#   # edit .env with your credentials
#   ./benchmarks/run_k8s.sh      # secret auto-synced before jobs
#   ./benchmarks/run_slurm.sh    # docker login run before container jobs
#   ./benchmarks/run_mpi.sh      # docker login run on all hostfile nodes
#
# Alternatively, export directly in your shell:
#   export DOCKER_USER=johnsontogether
#   export DOCKER_TOKEN=dckr_pat_xxxx

DOCKER_USER=johnsontogether
DOCKER_TOKEN=dckr_pat_xxxx
DOCKER_REGISTRY=docker.io
